            ++dest;
        }
    }

    result = std::distance(dest, e);
    c.erase(dest, e);
    return result;
}

template <typename Container, typename T>
auto sequential_erase(Container &c, const T &t)
{
    
    auto cmp = [&](const auto &e) -> bool { return e == t; };
    return sequential_erase_if(c, cmp); 
}

