QPushButton {
    background: rgb(255,255,252);
    border: 1px solid rgb(232,232,236);
    border-radius: 5px;
    padding: 2px 2px;
}
QPushButton:hover{
    background: rgb(240,240,235);
}

QLineEdit{
    border-radius: 5px;
    padding: 2px;
    border: 1px solid rgb(232,232,236);
}

QComboBox {
    background: rgb(255,255,252);
    border: 1px solid rgb(232,232,236);
    border-radius: 5px;
    padding: 2px;
}

QComboBox:hover {
    background: rgb(245,245,243);
}

QComboBox::drop-down {
    border: none;
    padding: 2px;
}

QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
}

QSpinBox,
QDoubleSpinBox {
    background: rgb(255,255,252);
    border: 1px solid rgb(232,232,236);
    border-radius: 5px;
    padding: 2px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0px;
    border: none;
}

QSpinBox::up-arrow,
QSpinBox::down-arrow,
QDoubleSpinBox::up-arrow,
QDoubleSpinBox::down-arrow {
    image: none;
}

QLineEdit {
    background: rgb(255,255,252);
    border: 1px solid rgb(232,232,236);
    border-radius: 5px;
    padding: 2px;
    color: rgb(24,24,26);
    selection-background-color: rgb(90,95,255);
    selection-color: white;
}

QLineEdit:focus {
    border: 1px solid rgb(180,180,190);
    background: white;
}

QLabel {
    color: rgb(70,70,74);
    background: transparent;
    font-size: 14px;
}

QLabel[heading="true"] {
    font-size: 18px;
    font-weight: 600;
    color: rgb(24,24,26);

    margin-top: 2px;
    margin-bottom: 2px;
}

QCheckBox {
    spacing: 2px;
    color: rgb(40,40,42);
    font-size: 10px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 5px;
    border: 1px solid rgb(210,210,214);
    background: rgb(255,255,252);
}

QCheckBox::indicator:hover {
    border: 1px solid rgb(160,160,170);
}
QCheckBox::indicator:checked {
    background: rgb(90,95,255);
    border: 1px solid rgb(90,95,255);
}
QComboBox QAbstractItemView {
    background: rgb(255,255,252);
    border: 1px solid rgb(232,232,236);
    selection-background-color: rgba(90,95,255,0.15);
    selection-color: rgb(24,24,26);
} 
QCheckBox:focus {
    outline: none;
}