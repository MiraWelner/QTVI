* {
    font-family: "Inter", "Segoe UI", "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: rgb(28,28,34);
}

QWidget {
    background: transparent;
}

QMainWindow,
QDialog {
    background: rgb(250,250,249);
}

/* Buttons */
QPushButton {
    background: rgb(255,255,255);
    border: 1px solid rgb(226,226,231);
    border-radius: 5px;
    padding: 3px 9px;
    font-weight: 500;
    color: rgb(40,40,46);
}
QPushButton:hover {
    background: rgb(248,248,250);
    border: 1px solid rgb(205,205,212);
}
QPushButton:pressed {
    background: rgb(241,241,244);
    border: 1px solid rgb(196,196,204);
}
QPushButton:disabled {
    background: rgb(248,248,248);
    border: 1px solid rgb(234,234,238);
    color: rgb(176,176,184);
}

/* Primary button: btn->setProperty("primary", true); */
QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 rgb(99,91,255), stop:1 rgb(82,72,235));
    border: 1px solid rgb(72,62,225);
    color: white;
    font-weight: 600;
}
QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 rgb(110,103,255), stop:1 rgb(92,82,245));
}
QPushButton[primary="true"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 rgb(82,72,235), stop:1 rgb(70,60,215));
}
QPushButton[primary="true"]:disabled {
    background: rgb(200,198,235);
    border: 1px solid rgb(200,198,235);
    color: rgb(244,244,255);
}

/* Text fields */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background: rgb(255,255,255);
    border: 1px solid rgb(226,226,231);
    border-radius: 5px;
    padding: 3px 7px;
    color: rgb(28,28,34);
    selection-background-color: rgb(90,82,245);
    selection-color: white;
}
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border: 1px solid rgb(205,205,212);
}
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid rgb(99,91,255);
    background: white;
}
QLineEdit:disabled {
    background: rgb(248,248,248);
    color: rgb(176,176,184);
}

/* Combo box */
QComboBox {
    background: rgb(255,255,255);
    border: 1px solid rgb(226,226,231);
    border-radius: 5px;
    padding: 3px 7px;
}
QComboBox:hover {
    border: 1px solid rgb(205,205,212);
}
QComboBox:focus {
    border: 1px solid rgb(99,91,255);
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    border: none;
}
QComboBox::down-arrow {
    image: none;
    width: 6px;
    height: 6px;
    border-left: 2px solid rgb(140,140,150);
    border-bottom: 2px solid rgb(140,140,150);
    margin-right: 7px;
}
QComboBox QAbstractItemView {
    background: rgb(255,255,255);
    border: 1px solid rgb(226,226,231);
    border-radius: 7px;
    padding: 3px;
    outline: none;
    selection-background-color: rgb(238,237,255);
    selection-color: rgb(28,28,34);
}
QComboBox QAbstractItemView::item {
    padding: 5px 8px;
    border-radius: 4px;
}

/* Spin boxes */
QSpinBox,
QDoubleSpinBox {
    background: rgb(255,255,255);
    border: 1px solid rgb(226,226,231);
    border-radius: 5px;
    padding: 3px 7px;
}
QSpinBox:hover,
QDoubleSpinBox:hover {
    border: 1px solid rgb(205,205,212);
}
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid rgb(99,91,255);
}
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0px;
    border: none;
}
QSpinBox::up-arrow,
QSpinBox::down-arrow,
QDoubleSpinBox::up-arrow,
QDoubleSpinBox::down-arrow {
    image: none;
}

/* Labels & headings */
QLabel {
    color: rgb(92,92,100);
    background: transparent;
    font-size: 13px;
}
QLabel[heading="true"] {
    font-size: 15px;
    font-weight: 700;
    color: rgb(22,22,28);
    margin-top: 1px;
    margin-bottom: 2px;
}
QLabel[subheading="true"] {
    font-size: 12px;
    font-weight: 500;
    color: rgb(140,140,150);
}

/* Check boxes & radio buttons */
QCheckBox,
QRadioButton {
    spacing: 6px;
    color: rgb(48,48,54);
    font-size: 13px;
    padding: 1px 0;
}
QCheckBox::indicator,
QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid rgb(206,206,214);
    background: rgb(255,255,255);
}
QCheckBox::indicator {
    border-radius: 4px;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border: 1px solid rgb(150,148,235);
}
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 rgb(99,91,255), stop:1 rgb(82,72,235));
    border: 1px solid rgb(82,72,235);
    image: none;
}
QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 rgb(99,91,255), stop:1 rgb(82,72,235));
    border: 3px solid white;
}
QCheckBox:focus,
QRadioButton:focus {
    outline: none;
}

/* Group box */
QGroupBox {
    background: rgb(255,255,255);
    border: 1px solid rgb(232,232,237);
    border-radius: 7px;
    margin-top: 9px;
    padding: 8px 8px 6px 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 9px;
    padding: 0 4px;
    color: rgb(60,60,68);
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid rgb(232,232,237);
    border-radius: 7px;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: rgb(120,120,130);
    padding: 4px 11px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}
QTabBar::tab:hover {
    color: rgb(60,60,70);
}
QTabBar::tab:selected {
    color: rgb(82,72,235);
    border-bottom: 2px solid rgb(82,72,235);
}

/* Progress bar */
QProgressBar {
    background: rgb(236,236,240);
    border: none;
    border-radius: 4px;
    height: 7px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 rgb(99,91,255), stop:1 rgb(130,120,255));
}

/* Sliders */
QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background: rgb(232,232,237);
}
QSlider::sub-page:horizontal {
    height: 4px;
    border-radius: 2px;
    background: rgb(99,91,255);
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: white;
    border: 2px solid rgb(99,91,255);
}
QSlider::handle:horizontal:hover {
    background: rgb(245,245,255);
}

/* Scroll bars */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 1px;
}
QScrollBar::handle:vertical {
    background: rgb(208,208,214);
    border-radius: 4px;
    min-height: 26px;
}
QScrollBar::handle:vertical:hover {
    background: rgb(180,180,188);
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 1px;
}
QScrollBar::handle:horizontal {
    background: rgb(208,208,214);
    border-radius: 4px;
    min-width: 26px;
}
QScrollBar::handle:horizontal:hover {
    background: rgb(180,180,188);
}
QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* Menus & tooltips */
QMenu {
    background: rgb(255,255,255);
    border: 1px solid rgb(228,228,233);
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px 6px 11px;
    border-radius: 5px;
    color: rgb(40,40,46);
}
QMenu::item:selected {
    background: rgb(238,237,255);
    color: rgb(28,28,34);
}
QMenu::separator {
    height: 1px;
    background: rgb(236,236,240);
    margin: 4px 6px;
}
QToolTip {
    background: rgb(28,28,34);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}
QChartView {
    background: rgb(255,255,255);
    border: 1px solid rgb(232,232,237);
    border-radius: 7px;
}